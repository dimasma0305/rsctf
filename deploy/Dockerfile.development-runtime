FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# This stable runtime layer is intentionally compiler-free. compose.dev.yml
# mounts the shared local Cargo output directory read-only, so a Rust edit only
# needs a bounded local relink followed by a backend restart.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates git iproute2 ipset iptables libdbus-1-3 libibverbs1 \
       libnl-route-3-200 libpcap0.8t64 libsystemd0 python3 python3-venv \
       wireguard-tools \
    && install -d -o 65532 -g 65532 -m 0700 /var/lib/rsctf-event-sensor/spool \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
EXPOSE 8080 2223 51821/udp
ENTRYPOINT ["/opt/rsctf-debug/rsctf"]
