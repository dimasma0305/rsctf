# Copy this file to .env, or let `scripts/install.sh` create a secure one.
# The installer never rotates or overwrites an existing secret.

COMPOSE_PROJECT_NAME=rsctf
COMPOSE_FILE=compose.yml

# Published rsctf full-stack image (Rust server plus the built web client).
# Verified release bundles fill this with the matching immutable OCI digest.
# When configuring a checkout manually, copy a reviewed release digest here;
# mutable tags such as `latest` are not a safe production default.
RSCTF_IMAGE=
# Keep `all` for the normal one-container deployment. compose.roles.yml
# overrides the public service to `web` and adds one `control` owner. Before
# selecting that overlay, keep the exact digest above unchanged across
# migration, web, and control.
RSCTF_ROLE=all

POSTGRES_USER=rsctf
POSTGRES_DB=rsctf
POSTGRES_PASSWORD=change-me-in-production
RSCTF_JWT_SECRET=change-me-in-production
# Dedicated pseudonymous-identity HMAC key. Generate separately from the JWT
# secret with `openssl rand -hex 32`; keep it stable across JWT rotations.
RSCTF_IDENTITY_HASH_KEY=
# Required by the maintained Compose files so a fresh database cannot start in
# an unbootstrappable state. Generate with `openssl rand -hex 32`; the server
# consults it only while the user table is empty. Keep it out of URLs and logs.
RSCTF_BOOTSTRAP_TOKEN=

# Safe local-only defaults. Production should use an https:// URL and true.
RSCTF_PUBLIC_URL=http://localhost:8080
# The A&D VPN Compose overlays default this to the private rsctf service alias.
# Set an explicit internal Service origin for a Kubernetes KotH deployment.
RSCTF_KOTH_REPORTER_BASE_URL=http://rsctf-koth-reporter:8080
RSCTF_COOKIE_SECURE=false
# CAPTCHA is opt-in. The Admin UI persists later policy changes in PostgreSQL.
RSCTF_USE_CAPTCHA=false
RSCTF_HTTP_BIND_IP=127.0.0.1
RSCTF_HTTP_PORT=8080
# Exact static address used only by the optional Caddy override. In local mode
# no peer has this address, so forwarded headers remain untrusted.
RSCTF_TRUSTED_PROXY_CIDRS=172.31.252.2/32

RUST_LOG=info
REDIS_MAXMEMORY=256mb
# Four maximum-size A&D submit batches per participation, then 10 flags/second.
# Raise only for a controlled, isolated load campaign; valid range 100..3200.
RSCTF_AD_SUBMIT_BURST_FLAGS=400
# Managed Leaderboard KotH capability exchanges share the arena source IP.
# Sustains the maintained 100-authentication/s, 2,000-team profile; valid range 3000..1000000.
RSCTF_KOTH_CAPABILITY_IP_ADMISSION_PER_MINUTE=6000
# All/control/engine full-history anti-cheat sweep interval (1..3600 seconds).
RSCTF_SUSPICION_RECONCILE_SECONDS=30
# Pause ended-game sweeps before the barrier-backed final pass (1..3600 seconds).
RSCTF_SUSPICION_FINALIZE_GRACE_SECONDS=360
# Per-role connection caps cover nested repository/provisioning and roster
# locks, singleton reconcilers, the capture heartbeat, and managed KotH
# capability authentication. With R=1 and P=4, the maintained web minimum is
# 27 and VPN control uses its 22-connection base plus 16 callback slots.
RSCTF_DB_MAX_CONNECTIONS=50
RSCTF_WEB_DB_MAX_CONNECTIONS=27
RSCTF_CONTROL_DB_MAX_CONNECTIONS=38
RSCTF_PROVISIONING_CONCURRENCY=4
RSCTF_REPO_SCAN_CONCURRENCY=1
RSCTF_CONTAINER_MAX_MEMORY_MB=4096
RSCTF_CONTAINER_MAX_CPU_COUNT=8
# Packet capture is disabled unless the topology-specific capture overlay is
# selected. The overlay sets this true and grants only its owner NET_RAW.
RSCTF_TRAFFIC_CAPTURE_ENABLED=false
RSCTF_CAPTURE_DEVICE=any
RSCTF_CAPTURE_RECONCILE_SECONDS=2
# Reserve these otherwise-unused numeric identities for checker subprocesses.
# The PID cgroup remains the aggregate fork backstop.
RSCTF_CHECKER_UID_BASE=60000
RSCTF_CHECKER_PROCESS_BUDGET=32
RSCTF_APP_PIDS_LIMIT=1024
# Bound each long-running Compose service's Docker JSON logs. Challenge
# workload containers use their own stricter 5m x 3 limit.
RSCTF_DOCKER_LOG_MAX_SIZE=20m
RSCTF_DOCKER_LOG_MAX_FILES=5

# Shared blob storage. Local remains the single-host default. S3 covers
# content-addressed blobs; split/multi-host installs still need a shared
# RSCTF_STORAGE_ROOT for repository worktrees, captures, and checker artifacts.
RSCTF_STORAGE_BACKEND=local
RSCTF_S3_BUCKET=
RSCTF_S3_REGION=
RSCTF_S3_ENDPOINT=
RSCTF_S3_PREFIX=assets
RSCTF_S3_ACCESS_KEY=
RSCTF_S3_SECRET_KEY=
# Disabled by default. With private S3 storage, a value from 30 through 3600
# lets authorized static challenge downloads use short-lived direct URLs.
# Team-specific attachments and writeups always remain on the RSCTF proxy.
RSCTF_ASSET_SIGNED_URL_TTL_SECS=0

# Docker challenge backend (add compose.docker.yml to COMPOSE_FILE).
RSCTF_DOCKER_PUBLIC_ENTRY=localhost
# PlatformProxy ports bind to this dedicated private bridge gateway rather than
# every host interface. Keep the subnet and gateway non-overlapping.
RSCTF_CHALLENGE_PROXY_SUBNET=172.31.253.0/24
RSCTF_DOCKER_PROXY_BIND=172.31.253.1
# Linux interface name used by the firewall guard (15 characters maximum).
RSCTF_CHALLENGE_PROXY_BRIDGE=rsctf-proxy0
# Optional stable installation name. rsctf hashes this before placing it in
# Docker labels. Leave empty to derive the scope from RSCTF_JWT_SECRET; set a
# unique value per installation before rotating that secret or sharing a daemon.
RSCTF_DOCKER_SCOPE=
# compose.docker.yml acknowledges that its scaled replicas share this host's
# one daemon. Do not set this for Kubernetes or independent node-local daemons.
# RSCTF_SHARED_DOCKER_DAEMON=true

# Caddy automatic HTTPS (add compose.caddy.yml to COMPOSE_FILE).
RSCTF_DOMAIN=ctf.example.com
RSCTF_PROXY_SUBNET=172.31.252.0/24
RSCTF_CADDY_IP=172.31.252.2
# Caddy resolves the stable rsctf-network alias dynamically. The role override
# moves that alias from the all-in-one process to the control process.
RSCTF_NETWORK_UPSTREAM_HOST=rsctf-network
RSCTF_NETWORK_UPSTREAM_PORT=8080

# Trusted outbound worker plane. Add compose.workers.yml for an all-in-one
# deployment, or compose.roles.workers.yml after compose.roles.yml. These files
# are intentionally not selected by the guided installer because they require
# a separately generated private CA and server certificate.
RSCTF_WORKER_PUBLIC_ENDPOINT=workers.ctf.example.com:9443
RSCTF_WORKER_SERVER_NAME=workers.ctf.example.com
RSCTF_WORKER_BIND_IP=0.0.0.0
RSCTF_WORKER_PORT=9443
# Keep none for pure remote mode. Select docker only when the Docker socket
# overlay is merged before the worker overlay in an all-in-one deployment; add
# compose.capture.yml last when local packet capture is also required. Split
# worker mode is remote-only until local lifecycle requests can be delegated
# safely. Kubernetes local mode is for an all-in-one in-cluster Helm deployment.
RSCTF_WORKER_LOCAL_BACKEND=none
# Fallback OCI platform for portable images launched through the existing
# one-container API. The shipped worker agent/runtime is Linux-only; keep the
# OS set to linux and set the architecture to match the Linux worker fleet.
# Do not change these defaults to Windows: Windows protocol fields are reserved
# for a future runtime, and v1 ships no native Windows workload artifact.
RSCTF_WORKER_DEFAULT_OS=linux
RSCTF_WORKER_DEFAULT_ARCH=amd64
RSCTF_WORKER_CA_CERT_HOST=./worker-secrets/worker-ca.crt
RSCTF_WORKER_CA_KEY_HOST=./worker-secrets/worker-ca.key
RSCTF_WORKER_SERVER_CERT_HOST=./worker-secrets/worker-server.crt
RSCTF_WORKER_SERVER_KEY_HOST=./worker-secrets/worker-server.key

# A&D VPN (add compose.ad-vpn.yml to COMPOSE_FILE; it includes Docker support
# and grants NET_ADMIN + NET_RAW only to the singleton VPN owner).
# Empty derives `<COMPOSE_PROJECT_NAME>-ad`; set an explicit unique name only
# when coordinating with an externally-created bridge.
RSCTF_AD_VPN_SERVICES_NETWORK=
RSCTF_AD_VPN_CLIENT_CIDR=10.13.0.0/19
RSCTF_AD_VPN_SERVICES_CIDR=10.13.40.0/24
RSCTF_AD_VPN_SERVER_ENDPOINT=ctf.example.com:51820
RSCTF_AD_VPN_PORT=51820
RSCTF_AD_SSH_PORT=2222
# Optional bounded event sensor. Use three independent stable random values;
# never reuse JWT, identity-hash, or database credentials.
RSCTF_EVENT_VPN_CREDENTIAL_KEY=
RSCTF_EVENT_VPN_PROOF_URL=https://ctf.example.com
# Exact /32 (or narrow internal) routes for the HTTPS origin and event services.
# Default routes are rejected; this feature never forces all player traffic
# through the organizer VPS.
RSCTF_EVENT_VPN_ALLOWED_IPS=
RSCTF_EVENT_SENSOR_TOKEN=
RSCTF_SOLVE_RECEIPT_ISSUER_TOKEN=
# Add `event-sensor` to COMPOSE_PROFILES only after EVENT_SENSOR_TOKEN is set.
# COMPOSE_PROFILES=event-sensor
# Optional local `CIDR,ASN,CLASS` prefix file mounted by an operator override.
RSCTF_EVENT_SENSOR_ASN_FILE=
