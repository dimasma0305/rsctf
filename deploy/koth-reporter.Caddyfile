{
	admin off
	auto_https off
}

:8080 {
	# Only lifecycle-authenticated reporter routes cross the service-network fence.
	@context {
		method GET
		path_regexp ^/api/v1/koth/games/[1-9][0-9]*/challenges/[1-9][0-9]*/context$
	}
	@observations {
		method POST
		path_regexp ^/api/v1/koth/games/[1-9][0-9]*/challenges/[1-9][0-9]*/observations$
	}
	@capability {
		method POST
		path /api/v1/koth/capability/authenticate
	}
	handle @capability {
		reverse_proxy rsctf-koth-backend:8080
	}
	handle @context {
		reverse_proxy rsctf-koth-backend:8080
	}
	handle @observations {
		reverse_proxy rsctf-koth-backend:8080
	}
	handle /healthz {
		reverse_proxy rsctf-koth-backend:8080
	}
	handle {
		respond 404
	}
}
