#!/usr/bin/env bash
set -euo pipefail
unset CDPATH
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
command -v python3 >/dev/null || { printf 'Install Python 3, then run this command again.\n' >&2; exit 1; }
python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))' || { printf 'Install Python 3.9 or newer, then try again.\n' >&2; exit 1; }
exec python3 "$root/scripts/manage.py" "$@"
